NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopoll
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.example.com
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# Optional storefront alias for a single-store custom-distribution deployment.
SHOP_CUSTOM_DOMAIN=
SCOPES=read_products,read_orders,read_discounts,write_discounts,read_fulfillments,write_pixels,read_customer_events,write_app_proxy
SHOPOLL_PUBLIC_URL=https://your-app.example.com
SHOPOLL_ENCRYPTION_KEY=
SHOPOLL_TOKEN_PEPPER=
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_FLOW_SECRET=
KLAVIYO_ALLOWED_FLOW_IDS=
DEMO_MODE=false
